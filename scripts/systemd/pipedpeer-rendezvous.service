[Unit]
Description=pipedpeer introducer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pipedpeer rendezvous
DynamicUser=yes
StateDirectory=pipedpeer-rendezvous
Environment=HOME=/var/lib/pipedpeer-rendezvous XDG_STATE_HOME=/var/lib/pipedpeer-rendezvous
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
