# Driver collector, on the operator's laptop. telemetry.sh renders it:
# @RESULTS@ (absolute results/lab), @STORAGE@, @R2_ACCOUNT_ID@, @OTLP_PORT@. The awss3
# exporter is wired into pipelines only by the driver-r2.yaml overlay, which
# telemetry.sh adds when ~/.config/pipedpeer-lab/r2.env exists; its keys reach
# the collector as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the
# environment, never in a file.
extensions:
  file_storage:
    directory: @STORAGE@

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:@OTLP_PORT@
        max_recv_msg_size_mib: 64

  # One JSON line per run, appended by scripts/campaign/run.sh.
  file_log/runs:
    include: [@RESULTS@/runs.jsonl]
    start_at: beginning
    storage: file_storage
    resource:
      service.name: lab-runner
    operators:
      - type: json_parser
        parse_to: attributes
        on_error: send_quiet
        timestamp:
          parse_from: attributes.end_ns
          layout_type: epoch
          layout: ns

processors:
  batch:
    timeout: 1s
  # Fewer, larger objects in R2: one per signal per minute, or sooner at
  # 200k items (about 30 s of 33 PCs; README, Volume). Class A operations
  # stay near 3 per minute however many PCs send.
  batch/r2:
    timeout: 60s
    send_batch_size: 200000
    send_batch_max_size: 400000

exporters:
  # zstd: each write is a 4-byte big-endian length and one zstd frame holding
  # one OTLP JSON document (not a plain .zst file). otel/otelread.py reads
  # these and plain .jsonl alike.
  file/metrics:
    path: @RESULTS@/otel/metrics.zjsonl
    compression: zstd
    flush_interval: 1s
    rotation:
      max_megabytes: 256
      max_backups: 1000
  file/logs:
    path: @RESULTS@/otel/logs.zjsonl
    compression: zstd
    flush_interval: 1s
    rotation:
      max_megabytes: 256
      max_backups: 1000
  awss3:
    s3uploader:
      endpoint: https://@R2_ACCOUNT_ID@.r2.cloudflarestorage.com
      region: auto
      s3_force_path_style: true
      s3_bucket: pipedpeer-lab
      s3_prefix: otel
      compression: gzip
    marshaler: otlp_json

service:
  extensions: [file_storage]
  telemetry:
    metrics:
      level: none
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [file/metrics]
    logs:
      receivers: [otlp, file_log/runs]
      processors: [batch]
      exporters: [file/logs]
