// Figure 3.2 - Level 0 DFD (context diagram).
digraph DFD0 {
  rankdir=LR; bgcolor="white"; nodesep=0.6; ranksep=1.1;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  user  [label="User", shape=box, style="filled", fillcolor="#efedf7", color="#5b4b8a", penwidth=1.4, width=1.5, height=0.8];
  peer  [label="Peer node", shape=box, style="filled", fillcolor="#efedf7", color="#5b4b8a", penwidth=1.4, width=1.5, height=0.8];
  reg   [label="Registry\n(optional)", shape=box, style="filled", fillcolor="#f5f5f5", color="#888888", style="filled,dashed", penwidth=1.4, width=1.5, height=0.8];

  sys [label="0\nPipedPeer\ndaemon", shape=circle, style="filled", fillcolor="#dce9f7",
       color="#1e50a0", penwidth=1.8, width=1.7, fixedsize=true];

  user -> sys [label="  script, arguments,\l  working directory\l"];
  sys -> user [label="  streamed output,\l  result files\l"];
  sys -> peer [label="  closure, workspace,\l  parallel work\l"];
  peer -> sys [label="  capacity, load,\l  computed results\l"];
  sys -> reg  [label=" registration ", style=dashed];
  reg -> sys  [label=" peer list ", style=dashed];
}
