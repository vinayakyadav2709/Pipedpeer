// Figure 4.4 - Closure transfer: the store path is the cluster-wide cache key.
digraph ClosureCache {
  rankdir=TB; bgcolor="white"; nodesep=0.30; ranksep=0.42;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.1, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  pin  [label="Pinned nixpkgs revision\nsame inputs give the same store path\non every node, on any day", fillcolor="#fdf6e3", color="#8a6d1f"];
  bld  [label="Build closure locally\n/nix/store/<hash>-run"];
  ask  [label="Does the target already have it?", shape=diamond, fillcolor="#fdf6e3", color="#8a6d1f", margin="0.02"];
  skip [label="Ship nothing\nworkspace only", fillcolor="#e3f3e9", color="#2f7d4f"];
  exp  [label="Export and compress\nnix-store --export | gzip"];
  imp  [label="Import on the worker\ncache the archive by store path"];
  bcast[label="Broadcast to peers that lack it\nso they become eligible for spill work"];
  run  [label="Execute", fillcolor="#e3f3e9", color="#2f7d4f"];

  pin -> bld -> ask;
  ask -> skip [label="  yes: bin/run present  "];
  ask -> exp  [label="  no  "];
  exp -> imp -> bcast;
  skip -> run; bcast -> run;
}
