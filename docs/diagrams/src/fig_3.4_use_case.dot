// Figure 3.4 - Use case diagram.
// The system-boundary label sits at the bottom: at the top an association line
// from the User ran straight through it.
digraph UseCase {
  rankdir=LR; bgcolor="white"; nodesep=0.30; ranksep=1.9;
  node [fontname="Helvetica", fontsize=16];
  edge [fontname="Helvetica", fontsize=14, color="#666666", arrowhead=none];

  node [shape=box, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.6,
        width=1.7, height=0.9];
  user  [label="User"];
  admin [label="Node\noperator"];
  peer  [label="Peer\ndaemon"];
  intro [label="Introducer"];

  subgraph cluster_sys {
    label="PipedPeer"; labelloc=b; labeljust=l; fontsize=18; fontname="Helvetica";
    style="rounded"; color="#1e50a0"; penwidth=1.8; bgcolor="#fbfcff"; fontcolor="#1e50a0";
    margin="30,26";
    node [shape=ellipse, style=filled, fillcolor="#e7eefa", color="#3b6ea5",
          penwidth=1.2, width=0, height=0];
    u1 [label="Run a script on the cluster"];
    u2 [label="Ask for a GPU or a memory floor"];
    u3 [label="Train with data parallelism"];
    u4 [label="Inspect jobs and nodes"];
    u5 [label="Accept and lease work"];
    u6 [label="Serve a signed closure to peers"];
    u7 [label="Execute parallel chunks"];
    u8 [label="Install prerequisites"];
    u9 [label="Set the cluster secret"];
    u10 [label="Join a cluster across networks"];
    u11 [label="Register nodes, forward punches"];
  }

  user -> u1; user -> u2; user -> u3; user -> u4;
  admin -> u8; admin -> u9; admin -> u10;
  peer -> u5; peer -> u6; peer -> u7;
  intro -> u11;
}
