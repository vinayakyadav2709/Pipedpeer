// Figure 3.4 - Use case diagram.
digraph UseCase {
  rankdir=LR; bgcolor="white"; nodesep=0.18; ranksep=1.4;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#666666", arrowhead=none];

  user [label="User", shape=box, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.4, width=1.3, height=0.7];
  admin [label="Node\noperator", shape=box, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.4, width=1.3, height=0.7];
  peer [label="Peer\ndaemon", shape=box, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.4, width=1.3, height=0.7];

  subgraph cluster_sys {
    label="PipedPeer"; labeljust=l; fontsize=13; fontname="Helvetica";
    style="rounded"; color="#1e50a0"; penwidth=1.6; bgcolor="#fbfcff"; fontcolor="#1e50a0";
    node [shape=ellipse, style=filled, fillcolor="#e7eefa", color="#3b6ea5", penwidth=1.1];
    u1 [label="Run script on the cluster"];
    u2 [label="Request GPU or memory"];
    u3 [label="Train with data parallelism"];
    u4 [label="Inspect jobs and nodes"];
    u5 [label="Accept and lease work"];
    u6 [label="Serve closure to peers"];
    u7 [label="Execute parallel chunks"];
    u8 [label="Install prerequisites"];
    u9 [label="Manage the daemon"];
  }

  user -> u1; user -> u2; user -> u3; user -> u4;
  admin -> u8; admin -> u9; admin -> u4;
  peer -> u5; peer -> u6; peer -> u7;
  u2 -> u1 [style=dashed, label="extends", arrowhead=vee, color="#999999"];
  u3 -> u1 [style=dashed, label="extends", arrowhead=vee, color="#999999"];
}
