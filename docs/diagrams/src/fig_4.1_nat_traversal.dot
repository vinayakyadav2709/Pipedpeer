// Figure 4.1 - Joining across networks.
// Two nodes behind different routers; the introducer only exchanges addresses.
// Every daemon serves the introducer for its own cluster (UDP 4244); a node
// registers with every introducer it knows.
digraph NAT {
  rankdir=TB; bgcolor="white"; nodesep=0.22; ranksep=0.30; compound=true;
  node [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];

  intro [label="Introducer (UDP 4244)\nin every daemon or a\nhosted server; address\nbook keyed by a hash\nof the secret", fillcolor="#f5f5f5", color="#888888"];

  subgraph cluster_a {
    label="Node A, behind router A"; labeljust=l; fontsize=14; fontname="Helvetica";
    style="rounded"; color="#1e50a0"; penwidth=1.6; bgcolor="#fafcff"; fontcolor="#1e50a0";
    a1 [label="Gather candidates\nLAN, router-mapped,\nreflexive"];
    a2 [label="One UDP socket\nprobes, introducer,\nQUIC (port 4243)"];
    a1 -> a2 [style=invis];
  }
  subgraph cluster_b {
    label="Node B, behind router B"; labeljust=l; fontsize=14; fontname="Helvetica";
    style="rounded"; color="#2f7d4f"; penwidth=1.6; bgcolor="#f8fcf9"; fontcolor="#2f7d4f";
    node [fillcolor="#e3f3e9", color="#2f7d4f"];
    b1 [label="Gather candidates\nLAN, router-mapped,\nreflexive"];
    b2 [label="One UDP socket\n(port 4243)"];
    b1 -> b2 [style=invis];
  }

  race [label="Race every candidate pair\nevery 250 ms for 15 s", fillcolor="#fdf6e3", color="#8a6d1f"];
  bday [label="Birthday collision\n256 sockets on one side,\n600 probes to random\nports from the other", fillcolor="#fdf6e3", color="#8a6d1f", style="rounded,filled,dashed"];
  quic [label="QUIC link, TLS 1.3\nsigned hello bound to the session,\nHMAC proving the cluster secret;\nseen locally as an ordinary node", fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.6];
  none [label="No path: logged,\nrouted around, retried.\nNever relayed.", fillcolor="#fbe9e9", color="#a33333", style="rounded,filled,dashed"];

  a1 -> intro [label="register\levery 30 s\l"];
  b1 -> intro [label="register"];
  intro -> b2 [label="punch\lrequest\l", style=dashed];
  a2 -> race; b2 -> race;
  race -> quic [label="a pair\lanswers\l"];
  race -> bday [label="port per\ldestination\l"];
  bday -> quic [label="hit"];
  bday -> none [label="no hit", style=dashed];
}
