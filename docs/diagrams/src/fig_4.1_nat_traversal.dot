// Figure 4.1 - Joining across networks.
// Two nodes behind different routers; the introducer only exchanges addresses.
digraph NAT {
  rankdir=TB; bgcolor="white"; nodesep=0.45; ranksep=0.45; compound=true;
  node [fontname="Helvetica", fontsize=15, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];

  intro [label="Introducer (public address)\nreflectors UDP 38443, 38444\naddress book UDP 38445\nkeyed by hash(secret)", fillcolor="#f5f5f5", color="#888888"];

  subgraph cluster_a {
    label="Node A, behind router A"; labeljust=l; fontsize=15; fontname="Helvetica";
    style="rounded"; color="#1e50a0"; penwidth=1.6; bgcolor="#fafcff"; fontcolor="#1e50a0";
    a1 [label="Gather candidates\nlan | mapped (PCP, NAT-PMP, UPnP)\n| reflex (as the introducer saw it)"];
    a2 [label="One UDP socket, port 38447\nprobes, introducer, QUIC"];
    a1 -> a2 [style=invis];
  }
  subgraph cluster_b {
    label="Node B, behind router B"; labeljust=l; fontsize=15; fontname="Helvetica";
    style="rounded"; color="#2f7d4f"; penwidth=1.6; bgcolor="#f8fcf9"; fontcolor="#2f7d4f";
    node [fillcolor="#e3f3e9", color="#2f7d4f"];
    b1 [label="Gather candidates\nlan | mapped | reflex"];
    b2 [label="One UDP socket, port 38447"];
    b1 -> b2 [style=invis];
  }

  race [label="Race every candidate pair\nprobes every 250 ms, 15 s window", fillcolor="#fdf6e3", color="#8a6d1f"];
  bday [label="Birthday collision\n256 sockets on the port-per-destination side,\n600 probes to random ports from the other", fillcolor="#fdf6e3", color="#8a6d1f", style="rounded,filled,dashed"];
  quic [label="QUIC link, TLS 1.3\nsigned hello: node key fingerprint and cluster checked\nexposed locally as 127.0.0.1:port, an ordinary node", fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.6];
  none [label="No path: logged with the reason,\nrouted around, retried later.\nNever relayed.", fillcolor="#fbe9e9", color="#a33333", style="rounded,filled,dashed"];

  a1 -> intro [label="  register  "];
  b1 -> intro [label="  register  "];
  intro -> b2 [label="  punch request\l  (A's own candidates)\l", style=dashed];
  a2 -> race; b2 -> race;
  race -> quic [label="  a pair answers  "];
  race -> bday [label="  one NAT changes port\l  per destination\l"];
  bday -> quic [label="  a socket is hit  "];
  bday -> none [label="  no hit  ", style=dashed];
}
