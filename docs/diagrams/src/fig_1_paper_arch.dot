// Paper Fig. 1 - the system design of Figure 3.1 reduced to its roles, drawn
// narrow so its text prints at 8 pt or more in one IEEE column (3.5 in).
digraph PaperArch {
  rankdir=TB; newrank=true; bgcolor="white"; nodesep=0.18; ranksep=0.30;
  node [fontname="Helvetica", fontsize=15, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#1e50a0", penwidth=1.6, margin="0.10,0.06"];
  edge [fontname="Helvetica", fontsize=14, color="#555555"];

  sub [label="Submitting node\nbuild closure,\nplace job"];
  wrk [label="Worker node\nadmit, cache,\ncrun sandbox", fillcolor="#e3f3e9", color="#2f7d4f"];
  peers [label="Peers\nLAN or\ndirect link", shape=box3d, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.3];
  phone [label="Phones\nchunks", shape=box3d, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.3];
  intro [label="Introducer\n(every daemon)\nno job data", style="rounded,filled,dashed", fillcolor="#f5f5f5", color="#888888", penwidth=1.2];
  { rank=same; sub; wrk; }
  { rank=same; phone; peers; intro; }

  sub -> wrk [label="lease,\npaths", penwidth=1.6, color="#1e50a0"];
  wrk -> peers [style=dashed, label="work,\lclosure\l"];
  wrk -> phone [style=dashed];
  intro -> peers [style=dotted, arrowhead=none, color="#888888"];
  sub -> intro [style=invis];
}
