// Figure 4.7 - crun sandbox: what the job can and cannot see.
// The container's mounts are one table so the text prints at 8 pt or more.
digraph Sandbox {
  rankdir=LR; bgcolor="white"; nodesep=0.16; ranksep=0.9;
  node [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled",
        fillcolor="#faf3dd", color="#8a6d1f", penwidth=1.2, margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];

  subgraph cluster_host {
    label="Host"; labeljust=l; fontsize=14; fontname="Helvetica";
    style="rounded"; color="#8a6d1f"; penwidth=1.8; bgcolor="#fdfaf0"; fontcolor="#8a6d1f";
    margin="10,8";
    nix  [label="Nix store\n(system or private)"];
    work [label="Job workspace"];
    gpu  [label="GPU devices\nand drivers"];
    cg   [label="cgroup v2\n(daemon: half of RAM)"];
    net  [label="Host network"];
  }

  ct [shape=plain, style="", label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#a33333" bgcolor="#fdf6f6">
      <tr><td colspan="2" align="left"><font color="#a33333">crun container</font></td></tr>
      <tr><td port="nix" align="left">/nix</td><td align="left">read-only</td></tr>
      <tr><td port="work" align="left">/work</td><td align="left">read-write</td></tr>
      <tr><td align="left">/dev/shm</td><td align="left">mode 1777</td></tr>
      <tr><td align="left">/tmp, home</td><td align="left">scratch, private</td></tr>
      <tr><td port="dev" align="left">/dev/nvidia*</td><td align="left">device nodes</td></tr>
      <tr><td port="lib" align="left">driver libraries</td><td align="left">bound file by file</td></tr>
      <tr><td port="mem" align="left">memory.max</td><td align="left">2 x estimate, per job</td></tr>
      <tr><td port="net" align="left">network</td><td align="left">not isolated</td></tr>
      <tr><td colspan="2" align="left">Namespaces: pid, ipc, mount, uts</td></tr>
      <tr><td colspan="2" align="left">(+ user, when rootless)</td></tr>
      <tr><td colspan="2" align="left"><i>Not provided: network namespace,</i></td></tr>
      <tr><td colspan="2" align="left"><i>seccomp filter, capability list;</i></td></tr>
      <tr><td colspan="2" align="left"><i>the job runs as uid 0 inside</i></td></tr>
    </table>>];

  nix  -> ct:nix  [label="bind"];
  work -> ct:work [label="bind"];
  gpu  -> ct:dev  [label="devices"];
  gpu  -> ct:lib  [label="libraries"];
  cg   -> ct:mem  [label="child cgroup"];
  net  -> ct:net  [label="shared", style=dashed, color="#a33333", fontcolor="#a33333"];
}
