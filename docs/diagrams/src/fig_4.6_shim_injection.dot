// Figure 4.6 - How the interception shim reaches the interpreter.
digraph ShimInject {
  rankdir=TB; bgcolor="white"; nodesep=0.28; ranksep=0.45;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.1, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  emb  [label="Shim source embedded in the binary\nno install on any node"];
  tar  [label="Appended to the workspace archive\nas .pipedpeer/shim/sitecustomize.py\nthe user's project is never modified"];
  env  [label="Worker sets PYTHONPATH to that directory"];
  imp  [label="CPython imports sitecustomize\nbefore the user's first line runs", fillcolor="#fdf6e3", color="#8a6d1f"];
  nixp [label="Re-adds the Nix package paths it shadows\nwithout this, every import in the closure fails",
        fillcolor="#fdf6e3", color="#8a6d1f"];
  patch[label="Patches the parallel entry points", fillcolor="#fbe9e9", color="#a33333"];

  p1 [label="multiprocessing.Pool\nProcessPoolExecutor", fillcolor="#fbe9e9", color="#a33333"];
  p2 [label="pandas\ngroupby, merge, readers", fillcolor="#fbe9e9", color="#a33333"];
  p3 [label="numpy and torch\nmatmul, svd, eig", fillcolor="#fbe9e9", color="#a33333"];
  p4 [label="joblib and sklearn\nParallel, n_jobs", fillcolor="#fbe9e9", color="#a33333"];
  p5 [label="torch optimiser\ndata parallel training", fillcolor="#fbe9e9", color="#a33333"];

  user [label="Unmodified user script", fillcolor="#e3f3e9", color="#2f7d4f"];

  emb -> tar -> env -> imp -> nixp -> patch;
  patch -> p1; patch -> p2; patch -> p3; patch -> p4; patch -> p5;
  p1 -> user [style=invis]; p3 -> user [style=invis]; p5 -> user [style=invis];
  { rank=same; p1; p2; p3; p4; p5; }
}
