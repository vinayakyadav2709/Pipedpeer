// Figure 3.1 - PipedPeer system design (report).
// Every box is on the path. Every daemon serves the introducer for its own
// cluster; it is drawn apart, dashed, because a LAN cluster needs none and a
// hosted introducer-only server may take the role. Phones take chunks only.
// Labels are kept short so the text prints at 8 pt or more at text width.
digraph SystemDesign {
  rankdir=TB; newrank=true; compound=true; bgcolor="white"; nodesep=0.30; ranksep=0.28;
  node [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];
  graph [fontname="Helvetica", fontsize=15];

  subgraph cluster_submit {
    label="Submitting node"; labeljust=l;
    style="rounded"; color="#1e50a0"; penwidth=2.0; fontcolor="#1e50a0"; bgcolor="#fafcff";
    margin="14,12";
    build [label="Build the environment\nimports to a Nix closure"];
    place [label="Place the job\nfilter, score, lease"];
    coll  [label="Collect the results\nchanged files only"];
    build -> place [label="store path"];
    place -> coll [style=invis];
  }

  subgraph cluster_worker {
    label="Worker node"; labeljust=l;
    style="rounded"; color="#2f7d4f"; penwidth=2.0; fontcolor="#2f7d4f"; bgcolor="#f8fcf9";
    margin="14,12";
    node [fillcolor="#e3f3e9", color="#2f7d4f"];
    admit [label="Admit the job\nsecret, lease, memory"];
    cache [label="Closure cache\nkeyed by store path"];
    sandbox [label="crun sandbox\nscript and shim,\nmemory ceiling", fillcolor="#fbe9e9", color="#a33333"];
    admit -> cache [label="missing\npaths?"];
    cache -> sandbox [label="run"];
  }

  intro [label="Introducer, in every daemon\naddresses only, no job data", style="rounded,filled,dashed", fillcolor="#f5f5f5", color="#888888"];
  peers [label="Peer nodes\nsame daemon, this network\nor a direct link across networks", shape=box3d, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.5];
  phone [label="Phones (Termux)\npool and torch chunks", shape=box3d, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.5];
  { rank=same; build; admit; }
  { rank=same; place; cache; }
  { rank=same; coll; sandbox; }
  { rank=same; intro; peers; phone; }

  place -> cache [lhead=cluster_worker, penwidth=1.8, color="#1e50a0",
                  label="1 accept, commit\l2 paths, files\l3 run, stream\l"];
  sandbox -> coll [style=dashed, penwidth=1.6, color="#1e50a0", label="4 results"];
  cache   -> peers [style=dashed, label="signed closure"];
  sandbox -> peers [style=dashed, label="parallel work,\ltraining ranks\l"];
  sandbox -> phone [style=dashed, label="chunks"];
  intro -> peers [style=dotted, arrowhead=none, color="#888888", label="addresses"];
}
