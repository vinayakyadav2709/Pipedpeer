// Figure 4.1 - Placement pipeline: gather, filter, score, lease, retry.
// The three reject branches feed one collector so no edge has to cross the
// figure, and the queue path leaves from the bottom rather than looping back
// over the decision spine.
digraph Placement {
  rankdir=TB; bgcolor="white"; nodesep=0.34; ranksep=0.40;
  node [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];

  gather [label="Gather candidates\nnode store, discovery, registry, self"];
  f1 [label="Architecture matches?", shape=diamond, fillcolor="#fdf6e3", color="#8a6d1f", margin="0.04"];
  f2 [label="GPU present, if required?", shape=diamond, fillcolor="#fdf6e3", color="#8a6d1f", margin="0.04"];
  f3 [label="Memory, cores, VRAM enough?", shape=diamond, fillcolor="#fdf6e3", color="#8a6d1f", margin="0.04"];
  rej [label="Rejected\nreason recorded", fillcolor="#fbe9e9", color="#a33333"];

  score [label="Score the survivors\nload penalties, hardware bonuses"];
  lease [label="Reserve a lease on the best node\naccept, then commit"];
  run   [label="Execute", fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.5];
  wait  [label="Nothing eligible\nqueue, retry every 30 s", fillcolor="#fbe9e9", color="#a33333"];

  gather -> f1;
  f1 -> f2 [label=" yes "];
  f2 -> f3 [label=" yes "];
  f3 -> score [label=" yes "];
  score -> lease [label=" highest score "];
  lease -> run [label=" committed "];

  // All three rejections land on one collector, kept level with the filters.
  f1 -> rej [label=" no "];
  f2 -> rej [label=" no "];
  f3 -> rej [label=" no "];
  { rank=same; f2; rej; }

  score -> wait [label=" none survived ", color="#a33333", fontcolor="#a33333"];
  wait -> gather [label=" retry ", style=dashed, color="#a33333", fontcolor="#a33333"];

  lease -> score [label=" refused: next candidate ", style=dashed, color="#a33333", fontcolor="#a33333"];
  run -> score [label=" failed: reschedule with backoff ", style=dashed, color="#a33333", fontcolor="#a33333"];
  { rank=same; score; wait; }
}
