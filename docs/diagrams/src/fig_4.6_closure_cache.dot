// Figure 4.6 - Closure transfer: the store path is the cache key, and the
// store path is also the unit of transfer.
digraph ClosureCache {
  rankdir=TB; newrank=true; bgcolor="white"; nodesep=0.25; ranksep=0.30;
  node [fontname="Helvetica", fontsize=15, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=14, color="#555555"];

  pin  [label="Pinned package set\nsame inputs, same store path,\nevery machine, any day",
        fillcolor="#fdf6e3", color="#8a6d1f"];
  bld  [label="Build the closure"];
  ask  [label="Can the target\nrun it already?", shape=diamond,
        fillcolor="#fdf6e3", color="#8a6d1f", margin="0.04"];
  skip [label="Ship only\nthe workspace"];
  diff [label="Ask which store paths\nit lacks; send only those"];
  imp  [label="Import on the worker\n(a partial import is\nnever cached whole)"];
  bcast[label="Push to peers that\ncannot run it, signed,\nso they can share work"];
  bg   [label="Upload waits at most 60 s;\na slow peer finishes in the\nbackground, cut only after\n60 s with no bytes moving", style="rounded,filled,dashed"];
  prune[label="Prune caches LRU\n8 GiB each", style="rounded,filled,dashed"];
  run  [label="Execute", fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.5];

  pin -> bld -> ask;
  ask -> skip [label="  yes  "];
  ask -> diff [label="  no  "];
  diff -> imp -> bcast;
  bcast -> bg [style=dashed, label="  slow peer  "];
  bcast -> prune [style=dashed];
  skip -> run;
  bcast -> run;
  { rank=same; skip; diff; }
  { rank=same; pin; bld; }
  { rank=same; imp; bcast; }
  { rank=same; bg; prune; run; }
}
