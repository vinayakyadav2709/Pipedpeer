// Figure 4.10 - Data parallel training: gradients meet on the daemon port.
digraph DDP {
  rankdir=TB; bgcolor="white"; nodesep=0.40; ranksep=0.55;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.1, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  r0 [label="Rank 0\nown data shard", fillcolor="#e3f3e9", color="#2f7d4f"];
  r1 [label="Rank 1\nown data shard"];
  r2 [label="Rank 2\nown data shard"];

  board [label="Lead node daemon, ordinary daemon port\ncollects one gradient blob per rank,\nreleases the full set once all have arrived",
         fillcolor="#fdf6e3", color="#8a6d1f"];

  avg [label="Each rank averages the set itself\nand steps its optimiser\nweights stay identical across ranks",
       fillcolor="#fdf6e3", color="#8a6d1f"];

  note [label="No rank-to-rank sockets and no extra ports:\nthe one port that already works between\nevery pair of nodes carries the sync",
        shape=note, fillcolor="#ffffff", color="#888888", fontsize=10];

  r0 -> board [label=" gradients "];
  r1 -> board [label=" gradients "];
  r2 -> board [label=" gradients "];
  board -> avg [label=" all ranks present "];
  avg -> r0 [style=dashed, constraint=false];
  avg -> r1 [style=dashed, constraint=false];
  avg -> r2 [style=dashed, constraint=false];
  { rank=same; r0; r1; r2; }
  { rank=same; board; note; }
}
