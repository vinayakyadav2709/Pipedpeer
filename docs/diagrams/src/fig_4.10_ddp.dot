// Figure 4.10 - Data parallel training: gradients meet on the daemon port.
// The explanatory note lives in the caption, not the canvas: as a free-floating
// node it forced the graph a quarter wider and shrank every label.
digraph DDP {
  rankdir=TB; bgcolor="white"; nodesep=0.55; ranksep=0.60;
  node [fontname="Helvetica", fontsize=15, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=14, color="#555555"];

  r0 [label="Rank 0\nits own data shard"];
  r1 [label="Rank 1\nits own data shard"];
  r2 [label="Rank 2\nits own data shard"];

  board [label="Lead node daemon, on the ordinary daemon port\nholds one gradient blob per rank and releases\nthe whole set once every rank has arrived",
         fillcolor="#fdf6e3", color="#8a6d1f", penwidth=1.5];

  avg [label="Every rank averages the set it receives\nand steps its own optimiser, so the weights\nstay identical across ranks",
       fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.5];

  r0 -> board [label="  gradients  "];
  r1 -> board [label="  gradients  "];
  r2 -> board [label="  gradients  "];
  board -> avg [label="  the full set, once all ranks are in  ", penwidth=1.5];

  { rank=same; r0; r1; r2; }
}
