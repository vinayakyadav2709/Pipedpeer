// Figure 3.3 - Level 1 DFD (decomposition of the daemon).
// Process 6 is placed before 7 so the numbering matches the reading order, and
// the peer-facing edges leave from the right so none has to double back.
digraph DFD1 {
  rankdir=TB; bgcolor="white"; nodesep=0.28; ranksep=0.42;
  node [fontname="Helvetica", fontsize=19, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=17, color="#555555"];

  user  [label="User", shape=box, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.5];
  peers [label="Peer nodes", shape=box3d, style=filled, fillcolor="#efedf7", color="#5b4b8a", penwidth=1.5];

  p1 [label="1  Resolve\nenvironment"];
  p2 [label="2  Discover\npeers"];
  p3 [label="3  Place task\nfilter, score, lease"];
  p4 [label="4  Transfer\nclosure and workspace"];
  p5 [label="5  Execute\nsandboxed"];
  p6 [label="6  Distribute\nparallel work", fillcolor="#fbe9e9", color="#a33333"];
  p7 [label="7  Return\nresults"];

  d1 [label="D1   Node store", shape=box, style=filled, fillcolor="#faf3dd", color="#8a6d1f"];
  d2 [label="D2   Closure cache", shape=box, style=filled, fillcolor="#faf3dd", color="#8a6d1f"];
  d3 [label="D3   Job history", shape=box, style=filled, fillcolor="#faf3dd", color="#8a6d1f"];

  user -> p1 [label="  script  "];
  p1 -> p3 [label="  store path  "];
  p2 -> d1 [label="  upsert  "];
  d1 -> p3 [label="  healthy peers  "];
  p3 -> p4 [label="  lease  "];
  p4 -> d2 [label="  import  "];
  p4 -> p5;
  p5 -> p6 [label="  intercepted calls  ", style=dashed];
  p6 -> p7 [style=invis];
  p5 -> p7 [label="  exit  "];
  p7 -> user [label="  result files  "];
  p7 -> d3 [label="  record  ", style=dashed];

  // Everything that talks to a peer leaves from the right-hand column.
  p2 -> peers [label="  probe  ", style=dashed];
  d2 -> peers [label="  broadcast  ", style=dashed];
  p6 -> peers [label="  chunks  ", style=dashed];

  { rank=same; p6; p7; }
}
