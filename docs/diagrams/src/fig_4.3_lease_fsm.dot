// Figure 4.3 - Lease state machine on the worker.
digraph LeaseFSM {
  rankdir=LR; bgcolor="white"; nodesep=0.5; ranksep=1.0;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  start [label="", shape=circle, width=0.22, style=filled, fillcolor="#333333", color="#333333"];
  res   [label="Reserved\ncapacity held\nexpires after 30 s"];
  run   [label="Running\nrenewed every 30 s\nreaped after 5 min idle", fillcolor="#e3f3e9", color="#2f7d4f"];
  gone  [label="Released", shape=doublecircle, width=0.5, fixedsize=false, fillcolor="#f2f2f2", color="#666666"];

  start -> res [label=" accept "];
  res -> run  [label=" commit "];
  run -> gone [label=" complete "];
  res -> gone [label=" cancel, or expiry\l after a 5 s grace\l"];
  run -> gone [label=" submitter stops renewing\l (crash recovery)\l", style=dashed, color="#a33333"];
}
