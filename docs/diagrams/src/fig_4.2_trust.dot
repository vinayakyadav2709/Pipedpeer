// Figure 4.2 - The three layers of trust, and the one node key behind the wire
// layers and the closure signatures.
digraph Trust {
  rankdir=LR; bgcolor="white"; nodesep=0.22; ranksep=0.35;
  node [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled",
        fillcolor="#eef3fb", color="#3b6ea5", penwidth=1.2, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=13, color="#555555"];

  tok  [label="Shared secret\n32 random bytes,\nfrom set-up or invite;\nrequired on every route,\nsent only to a host\nthat proved it (HMAC)", fillcolor="#fdf6e3", color="#8a6d1f"];
  tls  [label="On a LAN: pinned TLS\ncertificate from the node key,\npinned by node id on first\ncontact; may fall back to HTTP"];
  quic [label="Across networks: QUIC\nsigned hello bound to\nthe session, checks the\nnode's fingerprint"];
  key  [label="Node key\nEd25519;\nfingerprint\nis the node id", fillcolor="#e3f3e9", color="#2f7d4f", penwidth=1.6];
  sig  [label="Closure signatures\nimported under the\nreceiver's Nix policy"];
  api  [label="Daemon\nAPI", fillcolor="#efedf7", color="#5b4b8a"];

  tok -> api [label="who may\lcall\l"];
  tls -> api [label="wire,\lLAN\l"];
  quic -> api [label="wire, across\lnetworks\l"];
  key -> quic [label="authenticates"];
  key -> tls [label="certificate"];
  key -> sig [label="signs"];
}
