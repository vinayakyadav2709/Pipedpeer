# The laptop side of the Ubuntu lab: the driver's tools, on Ubuntu 24.04.
# rclone comes from upstream: the 24.04 package (1.60) has no `serve s3`.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      pssh parallel rsync nmap iperf3 openssh-client python3 \
      python3-pytest python3-pip shellcheck git ca-certificates wget unzip procps iproute2 bc \
 && rm -rf /var/lib/apt/lists/* \
 && wget -qO /tmp/rclone.zip https://downloads.rclone.org/rclone-current-linux-amd64.zip \
 && unzip -q -j /tmp/rclone.zip '*/rclone' -d /usr/local/bin \
 && chmod 755 /usr/local/bin/rclone && rm /tmp/rclone.zip
# analyse.py needs scipy >= 1.15 (bootstrap(rng=)), newer than the 24.04 package.
RUN pip install -q --no-cache-dir --break-system-packages --ignore-installed numpy pandas scipy matplotlib
# uv: venv.sh ships this one static binary to every PC.
RUN wget -qO /tmp/uv.tgz https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-musl.tar.gz \
 && tar -xzf /tmp/uv.tgz -C /usr/local/bin --strip-components=1 uv-x86_64-unknown-linux-musl/uv \
 && rm /tmp/uv.tgz
CMD ["sleep", "infinity"]
